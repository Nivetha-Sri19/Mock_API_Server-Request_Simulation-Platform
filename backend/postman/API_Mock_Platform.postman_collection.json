{
  "info": {
    "name": "API Mock Platform",
    "_postman_id": "api-mock-platform-v1",
    "description": "API Mock Server & Request Simulation Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "mockApiId",
      "value": ""
    },
    {
      "key": "versionId",
      "value": ""
    },
    {
      "key": "scenarioId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"demo@example.com\",\"password\":\"Password@123\",\"full_name\":\"Demo User\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        }
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.access_token) pm.collectionVariables.set('token', json.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"demo@example.com\",\"password\":\"Password@123\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "Create Mock API",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.id) pm.collectionVariables.set('mockApiId', json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Users API\",\"description\":\"User mock endpoint\",\"base_path\":\"/users\",\"http_method\":\"GET\",\"is_private\":false}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/mock-apis",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "mock-apis"
          ]
        }
      }
    },
    {
      "name": "Create Version",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.id) pm.collectionVariables.set('versionId', json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"version\":\"v1\",\"is_active\":true}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/mock-apis/{{mockApiId}}/versions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "mock-apis",
            "{{mockApiId}}",
            "versions"
          ]
        }
      }
    },
    {
      "name": "Create Success Scenario",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.id) pm.collectionVariables.set('scenarioId', json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"scenario\":\"success\",\"status_code\":200,\"headers\":{\"Content-Type\":\"application/json\"},\"body\":{\"message\":\"Mock response\",\"users\":[{\"id\":1,\"name\":\"Nivetha\"}]},\"delay_ms\":0}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/mock-apis/{{mockApiId}}/versions/{{versionId}}/scenarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "mock-apis",
            "{{mockApiId}}",
            "versions",
            "{{versionId}}",
            "scenarios"
          ]
        }
      }
    },
    {
      "name": "Execute Dynamic Mock",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/mock/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "mock",
            "users"
          ]
        }
      }
    },
    {
      "name": "Dashboard",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/dashboard",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "dashboard"
          ]
        }
      }
    }
  ]
}